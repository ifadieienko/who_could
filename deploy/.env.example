# Non-secret preseed for: sudo ./server.sh install --non-interactive --config FILE
DATABASE_MODE=mariadb-local
PUBLIC_HOSTNAME=example.com
HTTP_PORT=80
HTTPS_PORT=443
HTTPS_MODE=disabled
DATABASE_NAME=who_could
DATABASE_USER=who_could
# Secrets may be supplied for disposable CI only. Omit in production to generate them.
# WHO_COULD_SECRET=
# DATABASE_PASSWORD=
# MARIADB_ROOT_PASSWORD=
# For external MariaDB, point to root-only files instead of plaintext:
# DATABASE_MODE=mariadb-external
# DATABASE_HOST=db.example.com
# DATABASE_PORT=3306
# DATABASE_PASSWORD_FILE=/root/who-could-mariadb-password
# DATABASE_SSL_CA_SOURCE=/root/mariadb-ca.pem
