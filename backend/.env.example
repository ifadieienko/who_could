WHO_COULD_ENV=development
# Set either the value or its _FILE counterpart (the file takes precedence).
# WHO_COULD_SECRET_FILE=/run/secrets/app_secret
# WHO_COULD_SECRET=<generate-a-random-value-of-at-least-32-characters>

# MariaDB is the only supported database engine.
# DATABASE_URL=mariadb+pymysql://who_could:password@localhost:3306/who_could
DATABASE_ENGINE=mariadb
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=who_could
DATABASE_USER=who_could
# DATABASE_PASSWORD=
# DATABASE_PASSWORD_FILE=/run/secrets/mariadb_local_password
# DATABASE_SSL_CA=/path/to/ca.pem
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_RECYCLE=1800
DATABASE_POOL_PRE_PING=true

# Workshop settings; use HTTPS for a remotely accessible service.
PUBLIC_URL=http://127.0.0.1:5173
UPLOAD_DIR=./uploads
BILLING_ENFORCED=false
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=  # Backward-compatible Starter price
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_BUSINESS=
# STRIPE_WEBHOOK_SECRET=
# SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
# SMTP_FROM=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_MESSAGE_DOMAIN=
